<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Owned toolbar instead of the decor action bar: under enforced edge-to-edge some
         devices no longer offset the decor content below the bar, overlapping the title. -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/about_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        app:title="@string/about_title_toolbar"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:menu="@menu/menu_about" />

    <ScrollView
        android:id="@+id/about_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/about_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/about_title"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/about_copyright"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/about_copyright"
                android:textSize="17sp"
                android:layout_marginBottom="24dp" />

            <Button
                android:id="@+id/about_website_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/about_website"
                android:textSize="17sp"
                android:layout_marginBottom="16dp"
                style="?attr/buttonBarButtonStyle" />

            <Button
                android:id="@+id/about_github_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/about_github"
                android:textSize="17sp"
                android:layout_marginBottom="16dp"
                style="?attr/buttonBarButtonStyle" />

            <Button
                android:id="@+id/about_mastodon_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/about_mastodon"
                android:textSize="17sp"
                style="?attr/buttonBarButtonStyle" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
