<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Owned toolbar instead of the decor action bar; see activity_about.xml. -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/help_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        app:title="@string/help_title_toolbar"
        app:navigationIcon="?attr/homeAsUpIndicator" />

    <ScrollView
        android:id="@+id/help_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/help_header_capture"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/help_header_capture"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/help_body_capture"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/help_body_capture"
                android:textSize="16sp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/help_header_mark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/help_header_mark"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/help_body_mark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/help_body_mark"
                android:textSize="16sp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/help_header_list"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/help_header_list"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/help_body_list"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/help_body_list"
                android:textSize="16sp"
                android:layout_marginBottom="16dp" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
